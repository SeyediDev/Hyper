@model Hyper.AdminPanel.Web.ViewModels.IntegrationDashboardViewModel
@using Hyper.Domain.Features.Integrations
@{ Layout = "_HyperAdminLayout"; ViewBag.Title = "یکسان‌سازی پروفایل | پنل مدیریت هایپریک"; }
<link rel="stylesheet" href="~/Content/merchant-simulation.css" />
<section class="profile-sync-page" dir="rtl">
 <header class="simulation-heading"><div><span class="simulation-eyebrow">مرکز یکسان‌سازی</span><h1>یکسان‌سازی پروفایل صاحب مغازه و غرفه‌دار</h1><p>مقادیر منبع مرجع، وضعیت اتصال و آخرین نتیجه‌ی Worker را در یک صفحه ببینید.</p></div><a asp-action="Index" class="simulation-secondary">انتخاب مغازه</a></header>
 @if (Model.Selected is null) { <div class="simulation-empty">ابتدا از بخش «مغازه‌دار و اتصال» یک مغازه را انتخاب کنید.</div> }
 else { var s=Model.Statistics!; <div class="simulation-selection"><strong>@Model.Selected.ShopName</strong> — شناسه مغازه‌دار: @Model.Selected.MerchantIdentifier — مغازه @Model.Selected.ShopId</div>
 <div class="profile-sync-grid"><article class="simulation-card"><h2>مقایسه اطلاعات پروفایل</h2><p class="simulation-help">مغازه مرجع تغییرات است؛ غرفه فقط پس از دریافت رویداد و موفقیت Worker به‌روزرسانی می‌شود.</p><div class="profile-columns"><div><h3>مغازه · هایپریک <small>منبع مرجع</small></h3><dl><dt>شناسه صاحب مغازه</dt><dd>@Model.Selected.MerchantIdentifier <b class="profile-ok">معتبر</b></dd><dt>نام کسب‌وکار</dt><dd>@Model.Selected.ShopName <b class="profile-ok">مرجع</b></dd><dt>وضعیت اتصال</dt><dd>@s.EnabledConnections از @s.Connections اتصال فعال</dd></dl></div><div><h3>غرفه · باسلام <small>همگام‌شونده</small></h3><dl><dt>هویت غرفه</dt><dd>پس از دسترسی پروفایل خوانده می‌شود</dd><dt>نام غرفه</dt><dd>از رخداد/پاسخ API باسلام مقایسه می‌شود</dd><dt>نتیجه فعلی</dt><dd><b class="profile-warn">نیازمند بررسی Worker</b></dd></dl></div></div></article>
 <article class="simulation-card"><h2>وضعیت لحظه‌ای Worker</h2><div class="profile-live"><span>●</span><div><strong>صف پایدار اتصال</strong><small>پردازش سریالی و قابل بازیابی</small></div><b>@s.OutboxCount(0)</b></div><div class="profile-metrics"><span>اجرای موفق<strong>@s.RunCount(1)</strong></span><span>نیازمند نگاشت<strong>@s.RunCount(3)</strong></span><span>صف ارسال<strong>@s.OutboxCount(0)</strong></span><span>خطای نهایی<strong>@s.OutboxCount(3)</strong></span></div><a asp-action="Dashboard" class="simulation-link">مشاهده آمار کامل و لاگ‌ها ←</a></article></div>
 <article class="simulation-card profile-fields"><h2>اطلاعاتی که در این مرحله یکسان می‌شود</h2><div class="profile-field-row"><b>هویت صاحب پروفایل</b><span>شناسه مغازه‌دار و هویت غرفه</span><em>مشروط به مجوز profile</em></div><div class="profile-field-row"><b>نام کسب‌وکار و غرفه</b><span>عنوان نمایشی و نام تجاری</span><em>قابل مقایسه</em></div><div class="profile-field-row"><b>تماس و نشانی</b><span>موبایل، ایمیل، آدرس و کدپستی</span><em>قرارداد API لازم است</em></div><div class="profile-field-row"><b>حساب تسویه</b><span>اطلاعات حساس مالی</span><em>در انتظار دسترسی و مجوز</em></div></article> }
</section>
