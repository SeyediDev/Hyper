@model Hyper.AdminPanel.Web.ViewModels.MerchantSimulationViewModel
@using Hyper.Domain.Entities.Integrations
@{
    Layout = "_HyperAdminLayout";
    ViewBag.Title = "شبیه‌سازی درخواست مغازه‌دار | پنل مدیریتی هایپریک";
}
<link rel="stylesheet" href="~/Content/merchant-simulation.css" />
<section class="merchant-simulation" dir="rtl">
    <header class="simulation-heading">
        <div><span class="simulation-eyebrow">پنل مدیریتی هایپریک</span><h1>شبیه‌سازی درخواست مغازه‌دار</h1>
        <p>مغازه‌دار و مغازه‌ای را انتخاب کنید که می‌خواهید درخواست اتصال را از طرف او بررسی کنید.</p></div>
        <span class="simulation-admin">ادمین: @Model.AdminName</span>
    </header>
    @if (TempData["SimulationNotice"] is string notice)
    {
        <div class="simulation-notice" role="status">@notice</div>
    }
    <div class="simulation-grid">
        <section class="simulation-card">
            <h2>۱. انتخاب مغازه‌دار و مغازه</h2>
            <form asp-action="Index" method="get" class="simulation-search">
                <label for="shop-search">نام مغازه یا شناسه مغازه‌دار</label>
                <div><input id="shop-search" name="search" value="@Model.Search" maxlength="200" placeholder="جست‌وجو در مغازه‌ها" />
                    <button type="submit" class="simulation-secondary">جست‌وجو</button></div>
            </form>
            @if (Model.Shops.Count == 0)
            {
                <p class="simulation-empty">مغازه‌ای با این مشخصات پیدا نشد.</p>
            }
            else
            {
                <form asp-action="Select" method="post">
                    <label for="selected-shop">مغازه‌دار / مغازه</label>
                    <select id="selected-shop" name="shopId" required size="7">
                        @foreach (var shop in Model.Shops)
                        {
                            <option value="@shop.ShopId" selected="@(Model.Selected?.ShopId == shop.ShopId)">@shop.ShopName — مغازه‌دار: @shop.MerchantIdentifier — مغازه @shop.ShopId</option>
                        }
                    </select>
                    <p class="simulation-help">حداکثر ۱۰۰ نتیجه نمایش داده می‌شود. برای یافتن موارد دیگر جست‌وجو کنید.</p>
                    <button type="submit" class="simulation-primary">فعال‌کردن این زمینه</button>
                </form>
            }
        </section>
        <section class="simulation-card">
            <h2>۲. درخواست توکن برای زمینه انتخاب‌شده</h2>
            @if (Model.Selected is { } selected)
            {
                <div class="simulation-selection" role="status">
                    <strong>@selected.ShopName</strong>
                    <dl><dt>شناسه مغازه‌دار</dt><dd>@selected.MerchantIdentifier</dd>
                        <dt>شناسه مغازه</dt><dd>@selected.ShopId</dd>
                        <dt>ادمین انجام‌دهنده</dt><dd>@Model.AdminName</dd>
                        <dt>اعتبار زمینه</dt><dd>۳۰ دقیقه از زمان انتخاب</dd></dl>
                </div>
                <form action="@Url.Content("~/api/auth/basalam/login")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contextTicket" value="@Model.ContextTicket" />
                    <input type="hidden" name="displayedShopId" value="@selected.ShopId" />
                    <p>با حساب صاحب غرفه وارد باسلام شوید و مجوزهای نمایش‌داده‌شده را تأیید کنید. نتیجه برای همین مغازه ذخیره می‌شود.</p>
                    <p class="simulation-help">مجوزهای درخواستی: <bdi>@ViewBag.OAuthScopes</bdi></p>
                    @if (ViewBag.OAuthConfigurationError is string configurationError)
                    {
                        <div class="simulation-notice" role="alert">@configurationError</div>
                        <p class="simulation-help">راهنمای راه‌اندازی: docs/BASALAM_OAUTH_WEB.md</p>
                        <button type="button" class="simulation-primary" disabled>ابتدا تنظیمات اتصال را تکمیل کنید</button>
                    }
                    else
                    {
                        <button type="submit" class="simulation-primary">ورود به باسلام و اعطای مجوز</button>
                    }
                    <p class="simulation-help">پس از تأیید به پنل برمی‌گردید. توکن نمایش داده نمی‌شود و دریافت آن، یکسان‌سازی خودکار را فعال نمی‌کند.</p>
                </form>
                @if (ViewBag.OAuthStatus is Hyper.Infrastructure.Features.Integrations.BasalamTokenStatus tokenStatus)
                {
                    <div class="simulation-selection" role="status">
                        <strong>توکن ذخیره‌شده: @tokenStatus.VendorName</strong>
                        <dl><dt>شناسه غرفه</dt><dd>@tokenStatus.VendorId</dd>
                            <dt>زمان دریافت (UTC)</dt><dd>@tokenStatus.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
                            <dt>انقضا (UTC)</dt><dd>@(tokenStatus.ExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "اعلام نشده")</dd>
                            <dt>وضعیت</dt><dd>@(!tokenStatus.IsActive ? "غیرفعال" : tokenStatus.ExpiresAtUtc <= DateTime.UtcNow ? "منقضی" : "ذخیره‌شده")</dd></dl>
                    </div>
                }
                <form asp-action="Clear" method="post"><button type="submit" class="simulation-link">پایان شبیه‌سازی این مغازه</button></form>
            }
            else
            {
                <div class="simulation-empty"><strong>هنوز مغازه‌ای انتخاب نشده است.</strong><p>پس از انتخاب، نام مغازه و مغازه‌دار را اینجا بررسی کنید.</p></div>
            }
        </section>
    </div>
</section>
