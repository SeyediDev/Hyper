@model Hyper.AdminPanel.Web.ViewModels.MerchantSimulationViewModel
@using Hyper.Integration.Domain.Entities.Integrations
@using Hyper.Integration.Domain.Features.Integrations
@{
    Layout = "_HyperAdminLayout";
    var authorization = (Hyper.Infrastructure.Features.Integrations.IntegrationAuthorizationOption)ViewBag.Authorization;
    ViewBag.Title = "شبیه‌سازی درخواست مغازه‌دار | پنل مدیریت هایپریک";
}
<link rel="stylesheet" href="~/Content/merchant-simulation.css" />
<section class="merchant-simulation" dir="rtl">
    <header class="simulation-heading">
        <div><h1>شبیه‌سازی درخواست مغازه‌دار</h1>
        <p>مغازه‌دار و مغازه‌ای را انتخاب کنید که می‌خواهید درخواست اتصال را از طرف او بررسی کنید.</p></div>
    </header>
    @if (TempData["SimulationNotice"] is string notice)
    {
        <div class="simulation-notice" role="status">@notice</div>
    }
    <div class="simulation-grid">
        <section class="simulation-card">
            <h2>۱. انتخاب مغازه‌دار و مغازه</h2>
            <form asp-action="Index" method="get" class="simulation-search">
                <label for="shop-search">نام مغازه یا شناسه مغازه‌دار</label>
                <div><input id="shop-search" name="search" value="@Model.Search" maxlength="200" placeholder="جست‌وجو در مغازه‌ها" />
                    <button type="submit" class="simulation-secondary">جست‌وجو</button></div>
            </form>
            @if (Model.Shops.Count == 0)
            {
                <p class="simulation-empty">مغازه‌ای با این مشخصات پیدا نشد.</p>
            }
            else
            {
                <form asp-action="Select" method="post">
                    <label for="selected-shop">مغازه‌دار / مغازه</label>
                    <select id="selected-shop" name="shopId" required size="7" title="برای فعال‌کردن سریع، روی مغازه دوبار کلیک کنید">
                        @foreach (var shop in Model.Shops)
                        {
                            <option value="@shop.ShopId" selected="@(Model.Selected?.ShopId == shop.ShopId)">@shop.ShopName — مغازه‌دار: @shop.MerchantIdentifier — مغازه @shop.ShopId</option>
                        }
                    </select>
                    <p class="simulation-help">حداکثر ۱۰۰ نتیجه نمایش داده می‌شود. برای یافتن موارد دیگر جست‌وجو کنید.</p>
                    <button type="submit" class="simulation-primary">فعال‌کردن این مغازه</button>
                </form>
            }
        </section>
        <section class="simulation-card">
            <h2>۲. درخواست توکن برای مغازه‌دار انتخاب‌شده</h2>
            <form asp-action="Index" method="get">
                <input type="hidden" name="search" value="@Model.Search" />
                <label for="integration-provider">پلتفرم غرفه</label>
                <select id="integration-provider" name="integrationProvider">
                    @foreach (var option in Hyper.Infrastructure.Features.Integrations.IntegrationAuthorizationCatalog.Options)
                    {
                        <option value="@option.Provider" selected="@(option.Provider == authorization.Provider)">@option.Title</option>
                    }
                </select>
                <button type="submit" class="simulation-secondary">انتخاب پلتفرم</button>
            </form>
            @if (Model.Selected is { } selected)
            {
                <div class="simulation-selection" role="status">
                    <strong>@selected.ShopName</strong>
                    <dl><dt>شناسه مغازه‌دار</dt><dd>@selected.MerchantIdentifier</dd>
                        <dt>شناسه مغازه</dt><dd>@selected.ShopId</dd>
                        <dt>ادمین انجام‌دهنده</dt><dd>@Model.AdminName</dd>
                        <dt>اعتبار توکن</dt><dd>۳۰ دقیقه از زمان انتخاب</dd></dl>
                </div>
                @if (authorization.Provider == IntegrationProvider.Basalam && ViewBag.OAuthAuthorizationUrl is string basalamAuthorizationUrl)
                {
                    <p>با حساب صاحب غرفه وارد @authorization.Title شوید و مجوزهای نمایش‌داده‌شده را تأیید کنید. پس از بازگشت، اتصال و تطبیق اولیه به‌صورت خودکار ثبت می‌شود.</p>
                    <p class="simulation-help">مجوزهای درخواستی: <bdi>@ViewBag.OAuthScopes</bdi></p>
                    <a class="simulation-primary" href="@basalamAuthorizationUrl">ورود به @authorization.Title و اعطای مجوز</a>
                    <p class="simulation-help">این دکمه مستقیماً به صفحه‌ی احراز هویت باسلام می‌رود.</p>
                }
                else if (authorization.Provider != IntegrationProvider.Basalam && authorization.StartPath is not null)
                {
                <form action="@Url.Content("~" + authorization.StartPath)" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contextTicket" value="@Model.ContextTicket" />
                    <input type="hidden" name="displayedShopId" value="@selected.ShopId" />
                    <p>با حساب صاحب غرفه وارد @authorization.Title شوید و مجوزهای نمایش‌داده‌شده را تأیید کنید. نتیجه برای همین مغازه ذخیره می‌شود.</p>
                    @if (authorization.Provider == IntegrationProvider.Basalam) { <p class="simulation-help">مجوزهای درخواستی: <bdi>@ViewBag.OAuthScopes</bdi></p> }
                    @if (ViewBag.OAuthConfigurationError is string configurationError)
                    {
                        <div class="simulation-notice" role="alert">@configurationError</div>
                        <p class="simulation-help">راهنمای راه‌اندازی: docs/BASALAM_OAUTH_WEB.md</p>
                        <button type="button" class="simulation-primary" disabled>@(authorization.UnavailableReason is null ? "ابتدا تنظیمات اتصال را تکمیل کنید" : "اتصال هنوز آماده نیست")</button>
                    }
                    else
                    {
                        <button type="submit" class="simulation-primary">ورود به @authorization.Title و اعطای مجوز</button>
                    }
                    <p class="simulation-help">پس از تأیید به پنل برمی‌گردید. توکن نمایش داده نمی‌شود و دریافت آن، یکسان‌سازی خودکار را فعال نمی‌کند.</p>
                </form>
                }
                else if (authorization.Provider == IntegrationProvider.Basalam)
                {
                    <div class="simulation-notice" role="alert">لینک ورود باسلام ساخته نشد؛ تنظیمات OAuth یا زمینه‌ی انتخاب‌شده را بررسی کنید.</div>
                }
                @if (ViewBag.OAuthStatus is Hyper.Infrastructure.Features.Integrations.BasalamTokenStatus tokenStatus)
                {
                    <div class="simulation-selection" role="status">
                        <strong>توکن ذخیره‌شده: @tokenStatus.VendorName</strong>
                        <dl><dt>شناسه غرفه</dt><dd>@tokenStatus.VendorId</dd>
                            <dt>زمان دریافت (UTC)</dt><dd>@tokenStatus.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
                            <dt>انقضا (UTC)</dt><dd>@(tokenStatus.ExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "اعلام نشده")</dd>
                            <dt>وضعیت</dt><dd>@(!tokenStatus.IsActive ? "غیرفعال" : tokenStatus.ExpiresAtUtc <= DateTime.UtcNow ? "منقضی" : tokenStatus.ConnectionEnabled ? "آماده اجرای سناریوی دمو" : "ذخیره‌شده؛ در انتظار فعال‌سازی عملیاتی")</dd></dl>
                    </div>
                }
                <section class="simulation-selection">
                    <h3>دریافت رویداد آزمایشی</h3>
                    <p class="simulation-help">پس از OAuth، رویدادهای «کالا» و «موجودی» برای تطبیق اولیه خودکار در صف ثبت شده‌اند. این فرم فقط برای شبیه‌سازی رویدادهای بعدی (تغییر کالا، تغییر غرفه یا درخواست دستی) است.</p>
                    @if (ViewBag.ScenarioConnections is IEnumerable<Hyper.Integration.Domain.Features.Integrations.IntegrationScenarioConnection> connections && connections.Any())
                    {
                        <form asp-action="ReceiveScenario" method="post">
                            <input type="hidden" name="eventId" value="@Guid.NewGuid().ToString("N")" />
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="contextTicket" value="@Model.ContextTicket" />
                            <label>اتصال</label>
                            <select name="connectionId">@foreach (var connection in connections) { <option value="@connection.Id">@connection.DisplayName — @connection.Provider</option> }</select>
                            <label>آیتم</label><select name="item"><option value="1">کالا</option><option value="2">موجودی</option><option value="3">طرف حساب</option><option value="4">فروش</option><option value="5">خرید</option></select>
                            <label>محرک</label><select name="trigger"><option value="1">تغییر مغازه</option><option value="2">تغییر غرفه</option><option value="3">تطبیق اولیه</option><option value="4">تطبیق دوره‌ای</option><option value="5">درخواست دستی</option></select>
                            <button type="submit" class="simulation-primary">ثبت رویداد در صف</button>
                        </form>
                    }
                    else { <p class="simulation-help">برای این مغازه اتصالی ثبت نشده است.</p> }
                    @if (ViewBag.ScenarioJobs is IEnumerable<Hyper.Integration.Domain.Entities.Integrations.IntegrationScenarioJob> jobs)
                    {
                        <h4>آخرین رویدادها</h4><ul>@foreach (var job in jobs.Take(10)) { <li>
                            <strong>درخواست @job.Id</strong> — @(job.Item switch { IntegrationSyncItem.Product => "کالا", IntegrationSyncItem.Inventory => "موجودی", IntegrationSyncItem.Counterparty => "طرف حساب", IntegrationSyncItem.Sale => "فروش", _ => "خرید" })
                            — @(job.Status switch { IntegrationScenarioStatus.Pending => "در صف", IntegrationScenarioStatus.Running => "در حال پردازش", IntegrationScenarioStatus.Completed => "تطبیق بدون مغایرت", IntegrationScenarioStatus.NeedsAttention => "دارای مغایرت", _ => "خطای نهایی" })
                            @if (job.ErrorCode is not null) { <bdi>@job.ErrorCode</bdi> }
                            @if (job.ResultJson is not null) { <details><summary>جزئیات تطبیق</summary><pre dir="ltr">@job.ResultJson</pre></details> }
                        </li> }</ul>
                    }
                </section>                <form asp-action="Clear" method="post"><button type="submit" class="simulation-link">پایان شبیه‌سازی این مغازه</button></form>
            }
            else
            {
                <div class="simulation-empty"><strong>هنوز مغازه‌ای انتخاب نشده است.</strong><p>پس از انتخاب، نام مغازه و مغازه‌دار را اینجا بررسی کنید.</p></div>
            }
        </section>
    </div>
</section>

<script>
    // Double-clicking a search result performs the same action as the submit button.
    (() => {
        const shopSelect = document.getElementById('selected-shop');
        if (!shopSelect) return;

        shopSelect.addEventListener('dblclick', () => {
            const selectedOption = shopSelect.options[shopSelect.selectedIndex];
            if (!selectedOption || !selectedOption.value) return;

            selectedOption.selected = true;
            shopSelect.form?.requestSubmit();
        });
    })();
</script>
