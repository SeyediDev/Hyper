@model Hyper.WorkManagement.Contracts.WorkBoardResponse
@using Hyper.WorkManagement.Contracts
@{
    Layout = "_HyperAdminLayout";
    ViewBag.Title = "مدیریت کار | پنل مدیریت هایپریک";
    var columns = new[] { WorkItemStatus.Backlog, WorkItemStatus.Ready, WorkItemStatus.InProgress, WorkItemStatus.Blocked, WorkItemStatus.Review, WorkItemStatus.Done };
    string StatusText(WorkItemStatus status) => status switch { WorkItemStatus.Backlog => "بک‌لاگ", WorkItemStatus.Ready => "آماده اجرا", WorkItemStatus.InProgress => "در حال انجام", WorkItemStatus.Blocked => "مسدود", WorkItemStatus.Review => "بازبینی", WorkItemStatus.Done => "تکمیل‌شده", _ => "لغوشده" };
    string PriorityText(WorkItemPriority priority) => priority switch { WorkItemPriority.Critical => "بحرانی", WorkItemPriority.High => "بالا", WorkItemPriority.Low => "پایین", _ => "عادی" };
}
<link rel="stylesheet" href="~/Content/work-management.css" asp-append-version="true" />
<style>
 .work-management-filters{display:flex;gap:12px;align-items:end;background:#fff;border:1px solid #e5eaf1;border-radius:12px;padding:14px;margin-bottom:18px}.work-management-filters label{display:grid;gap:5px;color:#64748b;font-size:12px}.work-management-filters select{min-width:150px;border:1px solid #dbe3ed;border-radius:7px;padding:7px;background:#fff}.work-button{border:1px solid #dbe3ed;background:#fff;border-radius:6px;padding:5px 8px;color:#334155;cursor:pointer;font-size:11px}.work-button.primary{background:#2563eb;color:#fff;border-color:#2563eb}.work-item-actions{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}.work-item-details{background:#f8fafc;border-radius:6px;padding:8px;margin-top:8px;font-size:11px;line-height:2;color:#475569}
</style>
<section class="work-management-page" dir="rtl">
    <header class="work-management-heading">
        <div><span class="simulation-eyebrow">فضای توسعه و عملیات</span><h1>مدیریت کار</h1><p>کانبان مرکزی بک‌لاگ، Roleها، مالکیت تسک و شواهد تحویل.</p></div>
        <a class="simulation-secondary" asp-action="Index">تازه‌سازی</a>
    </header>
    <form class="work-management-filters" method="get" asp-action="Index">
        <label>پروژه <select name="project"><option value="">همه پروژه‌ها</option>@foreach (var project in Model.Projects) { <option selected="@(ViewBag.Project == project)" value="@project">@project</option> }</select></label>
        <label>دامین <select name="domain"><option value="">همه دامین‌ها</option>@foreach (var domainName in Model.Domains) { <option selected="@(ViewBag.Domain == domainName)" value="@domainName">@domainName</option> }</select></label>
        <label>رول <select name="role"><option value="">همه رول‌ها</option>@foreach (var role in Model.Roles.OrderBy(x => x.Key)) { <option selected="@(ViewBag.Role == role.Key)" value="@role.Key">@role.Name (@role.Key)</option> }</select></label>
        <label class="work-checkbox"><input type="checkbox" name="includeArchived" value="true" checked="@(ViewBag.IncludeArchived == true)" /> نمایش بایگانی‌شده‌ها</label>
        <button type="submit" class="work-button primary">اعمال فیلتر</button>
    </form>
    <div class="work-management-summary">
        <article><span>کل آیتم‌ها</span><strong>@Model.Metrics.TotalItems</strong></article>
        <article><span>در حال انجام</span><strong>@Model.Metrics.ActiveItems</strong></article>
        <article><span>زمان صرف‌شده</span><strong>@TimeSpan.FromSeconds(Model.Metrics.TimeSpentSeconds).ToString(@"dd\.hh\:mm")</strong><small>پیش‌بینی: @TimeSpan.FromSeconds(Model.Metrics.EstimatedSeconds).ToString(@"dd\.hh\:mm")</small></article>
        <article><span>پیشرفت زمانی</span><strong>@Model.Metrics.ProgressPercent٪</strong><div class="work-progress"><i style="width:@Model.Metrics.ProgressPercent%"></i></div></article>
    </div>
    <section class="work-management-card"><header><h2>کارتابل Roleها</h2><span>هر Role حداکثر یک تسک فعال دارد</span></header>
        <div class="work-role-grid">@foreach (var role in Model.Roles) { <div class="work-role @(role.IsAvailable ? "available" : "busy")"><span class="role-dot"></span><div><strong>@role.Name</strong><small>@role.Key</small></div><b>@(role.IsAvailable ? "آماده" : $"تسک #{role.ActiveWorkItemId}")</b></div> }</div>
    </section>
    <section class="work-management-card"><header><h2>کانبان بک‌لاگ</h2><span>منبع داده: WorkManagement</span></header>
        <div class="work-kanban">@foreach (var status in columns) { <div class="work-column"><header><h3>@StatusText(status)</h3><b>@Model.Items.Count(x => x.Status == status)</b></header><div class="work-column-items">@foreach (var item in Model.Items.Where(x => x.Status == status)) { <article class="work-item-card @(item.IsArchived ? "is-archived" : "")" data-item-id="@item.Id" data-project="@item.ProjectKey" data-parent="@(item.ParentWorkItemId?.ToString() ?? "")"><div class="work-item-top"><strong>@item.Key</strong><span class="priority-@item.Priority.ToString().ToLowerInvariant()">@PriorityText(item.Priority)</span></div><h4>@item.Title</h4><p><b>@item.ProjectKey</b> · @item.Domain @if (item.ParentWorkItemId is not null) { <span> · زیرتسک</span> }</p>@if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="work-item-description">@item.Description</p> }<div class="work-item-time">⏱ @TimeSpan.FromSeconds(item.TimeSpentSeconds).ToString(@"dd\.hh\:mm\:ss") / @(item.EstimatedSeconds is > 0 ? TimeSpan.FromSeconds(item.EstimatedSeconds.Value).ToString(@"dd\.hh\:mm\:ss") : "بدون پیش‌بینی") @if (item.IsTracking) { <em>در حال شمارش</em> }</div><div class="work-progress" title="پیشرفت بر اساس زمان"><i style="width:@item.ProgressPercent%"></i></div><small class="work-progress-label">@if (item.EstimatedSeconds is > 0) { <span>@item.ProgressPercent٪ از زمان پیش‌بینی‌شده</span> } else { <span>برای این کار زمان پیش‌بینی نشده</span> } @if (item.ChildCount > 0) { <span> · @item.ChildCount زیرتسک</span> }</small><footer><span>@(item.OwnerRole ?? "بدون مالک")</span>@if (item.Branch is not null) { <span dir="ltr">@item.Branch</span> }</footer><div class="work-item-actions"><button type="button" class="work-button details-button" data-id="@item.Id">جزئیات</button>@if (item.IsTracking) { <button type="button" class="work-button stop-button" data-id="@item.Id">توقف زمان</button> } else if (item.Status == WorkItemStatus.InProgress) { <button type="button" class="work-button start-button" data-id="@item.Id">شروع زمان</button> }<button type="button" class="work-button subtask-button" data-id="@item.Id" data-project="@item.ProjectKey">+ زیرتسک</button>@if (item.Status is WorkItemStatus.Blocked or WorkItemStatus.Done && !item.IsArchived) { <button type="button" class="work-button archive-button" data-id="@item.Id">بایگانی</button> } else if (item.IsArchived) { <button type="button" class="work-button unarchive-button" data-id="@item.Id">بازگردانی</button> }</div><div class="work-item-details" hidden></div></article>}</div></div> }</div>
    </section>
</section>
@section Scripts {
<script>
(() => {
 const api = '/api/work-management/v1';
 const json = async (url, method, body) => { const r = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body || {}) }); if (!r.ok) throw new Error(await r.text()); return r.status === 204 ? null : r.json(); };
 const refresh = () => window.location.reload();
 document.querySelectorAll('.start-button').forEach(b => b.addEventListener('click', async () => { try { await json(`${api}/items/${b.dataset.id}/time/start`, 'POST', {note:'شروع از داشبورد پنل'}); refresh(); } catch(e) { alert('شروع زمان انجام نشد'); } }));
 document.querySelectorAll('.stop-button').forEach(b => b.addEventListener('click', async () => { try { await json(`${api}/items/${b.dataset.id}/time/stop`, 'POST', {note:'توقف از داشبورد پنل'}); refresh(); } catch(e) { alert('توقف زمان انجام نشد'); } }));
 document.querySelectorAll('.subtask-button').forEach(b => b.addEventListener('click', async () => { const title = prompt('عنوان زیرتسک را وارد کنید:'); if (!title) return; const key = prompt('کلید زیرتسک را وارد کنید:', `SUB-${Date.now()}`); if (!key) return; const estimate = prompt('زمان پیش‌بینی‌شده به دقیقه (اختیاری):'); try { await json(`${api}/items`, 'POST', {projectKey:b.dataset.project, key, title, domain:'work-management', parentWorkItemId:Number(b.dataset.id), estimatedSeconds: estimate ? Number(estimate) * 60 : null}); refresh(); } catch(e) { alert('ایجاد زیرتسک انجام نشد'); } }));
 document.querySelectorAll('.archive-button,.unarchive-button').forEach(b => b.addEventListener('click', async () => { try { await json(`${api}/items/${b.dataset.id}/${b.classList.contains('archive-button') ? 'archive' : 'unarchive'}`, 'POST'); refresh(); } catch(e) { alert('عملیات بایگانی انجام نشد'); } }));
 const date = value => value ? new Date(value).toLocaleString('fa-IR') : '—';
 const minutes = value => value == null ? '—' : `${Math.floor(Number(value) / 60)} دقیقه`;
 document.querySelectorAll('.details-button').forEach(b => b.addEventListener('click', async () => { const card=b.closest('.work-item-card'), box=card.querySelector('.work-item-details'); if (!box.hidden) { box.hidden=true; return; } try { const d=await fetch(`${api}/items/${b.dataset.id}`).then(r=>r.json()); const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const logs = (d.logs || []).map(x => `<li><b>${esc(x.author)}</b><time>${date(x.createdAtUtc)}</time><p>${esc(x.message)}</p></li>`).join(''); const commits = (d.commits || []).map(x => `<li><code dir="ltr">${esc(x.sha)}</code><time>${date(x.createdAtUtc)}</time><p>${esc(x.message) || 'بدون توضیح'}</p></li>`).join(''); const tests = (d.tests || []).map(x => `<li><b>${esc(x.testName)}</b><span class="history-result">${esc(x.result)}</span><time>${date(x.createdAtUtc)}</time><p>${esc(x.details) || ''}</p></li>`).join(''); const times = (d.timeEntries || []).map(x => `<li><b>${minutes(x.durationSeconds)}</b><time>${date(x.startedAtUtc)} تا ${date(x.endedAtUtc)}</time><p>${esc(x.note) || ''}</p></li>`).join(''); const children = (d.children || []).map(x => `<li><b dir="ltr">${esc(x.key)}</b> — ${esc(x.title)} <span>${esc(x.status)}</span><small>${esc(x.description) || ''}</small></li>`).join(''); box.innerHTML=`<div class="history-description"><b>توضیحات:</b><p>${esc(d.item.description) || 'بدون توضیح'}</p></div><div><b>زمان:</b> ${minutes(d.item.timeSpentSeconds)} · پیش‌بینی: ${minutes(d.item.estimatedSeconds)} · پیشرفت: ${d.item.progressPercent}%</div><div class="history-grid"><section><h5>لاگ و تصمیم‌ها (${d.logs.length})</h5><ol>${logs || '<li>موردی ثبت نشده</li>'}</ol></section><section><h5>Commitها (${d.commits.length})</h5><ol>${commits || '<li>موردی ثبت نشده</li>'}</ol></section><section><h5>تست‌ها (${d.tests.length})</h5><ol>${tests || '<li>موردی ثبت نشده</li>'}</ol></section><section><h5>سوابق زمان (${d.timeEntries.length})</h5><ol>${times || '<li>موردی ثبت نشده</li>'}</ol></section></div><section><h5>زیرتسک‌ها (${d.children.length})</h5><ul>${children || '<li>زیرتسکی ندارد</li>'}</ul></section>`; box.hidden=false; } catch(e) { alert('دریافت سابقه انجام نشد'); } }));
})();
</script>
}
