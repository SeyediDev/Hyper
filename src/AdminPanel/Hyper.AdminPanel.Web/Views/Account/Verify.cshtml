@using Neo.Bpms.Domain.Features.MetaDefinitions.ProjectDefinitions
@using Neo.Bpms.UI.MVC
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.Resources.Resources
@using Hyper.AdminPanel.Web.ViewModels.Account
@using Neo.Bpms.Domain.Model.Project

@model VerifyLoginViewModel

@{
    ViewBag.Title = ViewTexts.VerifyLoginToSystem;
}

<div class="neo-login-container">
    <div class="neo-login-form-section">
        @using (Html.BeginForm("Verify", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, false, new { @class = "neo-login-form", role = "form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            HiddenFields();

            <h3 class="neo-login-title">
                پنل مدیریت هایپریک
            </h3>
            <h6 class="neo-login-subtitle">
                لطفا کد تایید ارسال شده را وارد کنید
            </h6>
            
            @Html.ValidationSummary(false, "", new { @class = "neo-login-field-validation-error" })
            
            <div class="neo-login-form-group">
                <div class="neo-login-input-container">
                    <img src="@Url.Content(SpecificCommonlyNeededAssets.GetImage("123"))" class="neo-login-input-icon" alt="Code Icon" />
                    @Html.TextBoxFor(m => m.Code, new
                        {
                            @class = "neo-login-input",
                            dir = "ltr",
                            placeholder = "کد ورود",
                            id = "codeInput"
                        })
                </div>
                @Html.ValidationMessageFor(m => m.Code, "", new { @class = "neo-login-field-validation-error" })
            </div>

            <div class="neo-login-form-group">
                <div class="neo-login-resend-container" id="resendContainer">
                    <div class="neo-login-checkbox-container">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "neo-login-checkbox" })
                        <label class="neo-login-checkbox-label" for="RememberMe">
                            @ViewTexts.RememberMe
                        </label>
                    </div>
                    <div class="neo-login-resend-section">
                        <span class="neo-login-resend-icon" id="resendIcon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M17.6498 6.34989C16.8116 5.50416 15.7942 4.8575 14.6726 4.45768C13.551 4.05786 12.3539 3.91508 11.1698 4.03989C7.49978 4.40989 4.47978 7.38989 4.06978 11.0599C3.51978 15.9099 7.26978 19.9999 11.9998 19.9999C13.5099 19.9999 14.989 19.5714 16.2653 18.7642C17.5415 17.957 18.5626 16.8043 19.2098 15.4399C19.5298 14.7699 19.0498 13.9999 18.3098 13.9999C17.9398 13.9999 17.5898 14.1999 17.4298 14.5299C16.8492 15.7789 15.8561 16.7899 14.6177 17.3927C13.3793 17.9955 11.971 18.1534 10.6298 17.8399C8.40978 17.3499 6.61978 15.5399 6.14978 13.3199C5.95221 12.4422 5.9545 11.5312 6.15647 10.6545C6.35845 9.77775 6.75494 8.95764 7.31663 8.25481C7.87831 7.55198 8.59082 6.98442 9.40145 6.59411C10.2121 6.20379 11.1001 6.00071 11.9998 5.99989C13.6598 5.99989 15.1398 6.68989 16.2198 7.77989L14.7098 9.28989C14.0798 9.91989 14.5198 10.9999 15.4098 10.9999H18.9998C19.5498 10.9999 19.9998 10.5499 19.9998 9.99989V6.40989C19.9998 5.51989 18.9198 5.06989 18.2898 5.69989L17.6498 6.34989Z" fill="currentColor" />
                            </svg>
                        </span>
                        <span id="resendText">تا ارسال مجدد</span>
                        <span class="neo-login-countdown" id="countdown">۰۲:۰۵</span>
                    </div>
                </div>
            </div>
            
            <div class="neo-login-form-group">
                <button type="submit" class="neo-login-submit-btn" id="verifySubmitBtn">
                    <span class="btn-text">@ViewTexts.LogIn</span>
                    <span class="btn-loader"></span>
                </button>
            </div>
        }
    </div>
    
    <div class="neo-login-brand-section app-header-gradient text-white">
        <div class="neo-login-brand-content">
            <!-- پنل مدیریت هایپریک Icon -->
            <div class="Hyper-svg-icon">
                <img src="@Url.Content("~/Content/images/logo.svg")" alt="هایپریک" class="hyperyek-brand-logo" />
            </div>

            <div class="neo-login-brand-title">
                پنل مدیریت هایپریک
            </div>
            <div class="neo-login-brand-subtitle">
                پنل مدیریت هایپریک
            </div>
        </div>
        <div class="neo-login-brand-footer">© Hyperyek. All Rights Reserved.</div>
    </div>
</div>

@functions
{
    void HiddenFields()
    {
        var hiddenFields = ViewBag.HiddenFields as IDictionary<string, string>;
        if (hiddenFields != null)
        {
            foreach (var pair in hiddenFields)
            {
                @Html.Hidden(pair.Key, pair.Value)
            }
        }
    }
     
}

<script>
    const countdownElement = document.getElementById('countdown');
    const resendText = document.getElementById('resendText');
    const resendContainer = document.getElementById('resendContainer');

    let timerDuration = 125; // ثانیه
    let seconds = timerDuration;
    let timer;

    function pad(n) {
      return n.toString().padStart(2, '0');
    }

    function toPersianDigits(str) {
      return str.replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
    }

    function updateCountdown() {
      const minutes = Math.floor(seconds / 60);
      const secs = seconds % 60;
      const timeString = `${pad(minutes)}:${pad(secs)}`;
      countdownElement.textContent = toPersianDigits(timeString);

      if (seconds > 0) {
        seconds--;
        timer = setTimeout(updateCountdown, 1000);
      } else {
        countdownElement.style.display = 'none';
        resendText.textContent = 'ارسال مجدد';
        resendContainer.classList.add('active');
        resendContainer.addEventListener('click', restartTimer);
      }
    }

    function startTimer() {
      resendContainer.classList.remove('active');
      resendText.textContent = 'تا ارسال مجدد';
      countdownElement.style.display = 'inline';
      seconds = timerDuration;
      updateCountdown();
    }

    function restartTimer() {
      resendContainer.removeEventListener('click', restartTimer);
      startTimer();
      // اینجا می‌تونی AJAX برای ارسال مجدد پیامک بزنی
      //console.log("📨 ارسال مجدد پیامک");
      //PostDataRedirect("@ViewBag.UserName" , "/Account/Login")
        $.ajax({
            type: 'POST',
            url: window.top.rootUrl+'Account/Resend',
            //contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            processData: true,
            cache: false,
            data: { userName: "@ViewBag.UserName"},
            headers: window.AddAntiForgeryToken(),
            success: function (res) {
                if (res) {
                    //ok
                }
            },
            error: function (e) {
                     alert(window.tetaI18n.t('Error Occured') + e.responseText);
                Error(e);
            }
        });
    }

    function PostDataRedirect(data , location) {
        var form = document.createElement("form");
        form.method = "post";
        form.action = location;
        var element1 = document.createElement("input");
        element1.type = "hidden";
        element1.value = data;
        element1.name = "UserName";
        form.appendChild(element1);
        document.body.appendChild(form);
        form.submit();
    }


    document.addEventListener("DOMContentLoaded", () => {
        startTimer();
        
        // Focus on input field
        const codeInput = document.getElementById("codeInput");
        if (codeInput) {
            codeInput.focus();
        }

        // Add loading state to submit button
        const verifyForm = document.querySelector('.neo-login-form');
        const submitBtn = document.getElementById('verifySubmitBtn');
        
        if (verifyForm && submitBtn) {
            verifyForm.addEventListener('submit', function(e) {
                // Show loading state immediately
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;
                
                // Lock input field (readonly keeps the value in POST)
                if (codeInput) {
                    codeInput.readOnly = true;
                    codeInput.classList.add('locked');
                }
            });
        }

        // Add input validation styling
        if (codeInput) {
            codeInput.addEventListener('blur', function() {
                if (this.value.trim() === '') {
                    this.classList.add('error');
                } else {
                    this.classList.remove('error');
                }
            });

            codeInput.addEventListener('input', function() {
                if (this.classList.contains('error') && this.value.trim() !== '') {
                    this.classList.remove('error');
                }
            });
        }
    });
</script>
