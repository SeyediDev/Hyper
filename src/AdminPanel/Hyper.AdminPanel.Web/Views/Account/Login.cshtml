@addTagHelper "BotDetect.Web.Mvc.CaptchaTagHelper, BotDetect.Web.Mvc"

@using Neo.Bpms.Domain.Features.MetaDefinitions.ProjectDefinitions
@using Neo.Bpms.UI.MVC
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.Resources.Resources
@using Hyper.AdminPanel.Web.ViewModels.Account
@using Neo.Bpms.Domain.Model.Project

@model LoginViewModel

@{
    ViewBag.Title = ViewTexts.LoginToSystem;
}

<div class="neo-login-container">
    <div class="neo-login-form-section">
        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, false, new { @class = "neo-login-form", role = "form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            HiddenFields();

            <h3 class="neo-login-title">
                پنل مدیریت هایپریک
            </h3>
            <h6 class="neo-login-subtitle">
                لطفا اطلاعات ورود خود را وارد کنید
            </h6>
            
            @Html.ValidationSummary(false, "", new { @class = "neo-login-field-validation-error" })
            
            <div class="neo-login-form-group">
                <div class="neo-login-input-container">
                    <img src="@Url.Content(SpecificCommonlyNeededAssets.GetImage("leading-icon"))" class="neo-login-input-icon" alt="User Icon" />
                    @Html.TextBoxFor(m => m.UserName, new
                        {
                            @class = "neo-login-input",
                            dir = "ltr",
                            placeholder = ViewTexts.Username,
                            id = "userNameInput"
                        })
                </div>
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "neo-login-field-validation-error" })
            </div>
           
            @if (ProjectDefinition.Project.CaptchaInLoginEnabled)
            {
                //await RenderCaptcha();
            }
            
            <div class="neo-login-form-group">
                <button type="submit" class="neo-login-submit-btn" id="loginSubmitBtn">
                    <span class="btn-text">@ViewTexts.LogIn</span>
                    <span class="btn-loader"></span>
                </button>
            </div>
        }
    </div>
    
    <div class="neo-login-brand-section">
        <div class="neo-login-brand-content">
            <!-- پنل مدیریت هایپریک Icon -->
            <div class="Hyper-svg-icon">
                <img src="@Url.Content("~/Content/images/hyper-icon.svg")" alt="هایپریک" style="width: 270px; height: 270px;" />
            </div>
            
            <div class="neo-login-brand-title">
                پنل مدیریت هایپریک
            </div>
            <div class="neo-login-brand-subtitle">
                پنل مدیریت هایپریک
            </div>
        </div>
        <div class="neo-login-brand-footer">© Hyperyek. All Rights Reserved.</div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Focus on input field
        const userNameInput = document.getElementById("userNameInput");
        if (userNameInput) {
            userNameInput.focus();
        }

        // Add loading state to submit button
        const loginForm = document.querySelector('.neo-login-form');
        const submitBtn = document.getElementById('loginSubmitBtn');
        
        if (loginForm && submitBtn) {
            loginForm.addEventListener('submit', function(e) {
                // Show loading state immediately
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;
                
                // Lock input field (readonly keeps the value in POST)
                if (userNameInput) {
                    userNameInput.readOnly = true;
                    userNameInput.classList.add('locked');
                }
            });
        }

        // Add input validation styling
        if (userNameInput) {
            userNameInput.addEventListener('blur', function() {
                if (this.value.trim() === '') {
                    this.classList.add('error');
                } else {
                    this.classList.remove('error');
                }
            });

            userNameInput.addEventListener('input', function() {
                if (this.classList.contains('error') && this.value.trim() !== '') {
                    this.classList.remove('error');
                }
            });
        }
    });
</script>

