	<!-- Microfrontend Build Configuration -->
	<PropertyGroup>
		<EditableGridSourcePath>$(MSBuildProjectDirectory)\..\..\..\..\..\Neo-Bpms\src\Neo.UI.EditableGrid</EditableGridSourcePath>
		<MonitoringSourcePath>$(MSBuildProjectDirectory)\..\..\..\..\..\Neo-Bpms\src\Neo.UI.Monitoring</MonitoringSourcePath>
		<EditableGridOutputPath>$(MSBuildProjectDirectory)\wwwroot\editable-grid</EditableGridOutputPath>
		<MonitoringOutputPath>$(MSBuildProjectDirectory)\wwwroot\monitoring</MonitoringOutputPath>
	</PropertyGroup>
	
	<!-- Microfrontend Build Configuration -->
	<!-- Only build microfrontends during Rebuild, not regular Build -->
	<!-- Rebuild = Clean + Build, so we use AfterTargets="Clean" to detect Rebuild -->
	<!-- Note: This will also run if user executes Clean separately, but that's acceptable -->
	
	<!-- Check Node.js and npm availability -->
	<Target Name="CheckNodeJs" AfterTargets="Clean" BeforeTargets="BuildMicrofrontendsOnRebuild">
		<Exec Command="node --version" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="NodeJsExitCode" />
		</Exec>
		<Exec Command="npm --version" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
		</Exec>
		
		<Error Condition="'$(NodeJsExitCode)' != '0'" Text="Node.js is not installed or not in PATH. Please install Node.js from https://nodejs.org/" />
		<Error Condition="'$(NpmExitCode)' != '0'" Text="npm is not installed or not in PATH. Please install npm (usually comes with Node.js)." />
		
		<Message Condition="'$(NodeJsExitCode)' == '0' AND '$(NpmExitCode)' == '0'" Text="? Node.js and npm are available" Importance="high" />
	</Target>
	
	<!-- Main target that builds all microfrontends - Only runs after Clean (i.e., during Rebuild) -->
	<Target Name="BuildMicrofrontendsOnRebuild" AfterTargets="Clean">
		<Message Text="========================================" Importance="high" />
		<Message Text="Building Microfrontends for Admin Panel (Rebuild only)" Importance="high" />
		<Message Text="========================================" Importance="high" />
		
		<Warning Condition="!Exists('$(EditableGridSourcePath)')" Text="EditableGrid source not found at: $(EditableGridSourcePath). Skipping build." />
		<Warning Condition="!Exists('$(MonitoringSourcePath)')" Text="Monitoring source not found at: $(MonitoringSourcePath). Skipping build." />
	</Target>
	
	<!-- Build EditableGrid Microfrontend -->
	<Target Name="BuildEditableGrid" AfterTargets="BuildMicrofrontendsOnRebuild" Condition="Exists('$(EditableGridSourcePath)')">
		<Message Text="Building Neo.UI.EditableGrid microfrontend..." Importance="high" />
		
		<Exec Command="npm install" WorkingDirectory="$(EditableGridSourcePath)" ContinueOnError="false" />
		
		<Exec Command="npm run build" WorkingDirectory="$(EditableGridSourcePath)" ContinueOnError="false" />
		
		<Message Text="Copying EditableGrid build output to wwwroot..." Importance="high" />
		<ItemGroup>
			<_EditableGridFiles Include="$(EditableGridSourcePath)\dist\**\*.*" />
		</ItemGroup>
		<MakeDir Directories="$(EditableGridOutputPath)" Condition="!Exists('$(EditableGridOutputPath)')" />
		<RemoveDir Directories="$(EditableGridOutputPath)" Condition="Exists('$(EditableGridOutputPath)')" />
		<MakeDir Directories="$(EditableGridOutputPath)" />
		<Copy SourceFiles="@(_EditableGridFiles)" DestinationFolder="$(EditableGridOutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
		
		<Message Text="? EditableGrid microfrontend built and copied successfully" Importance="high" />
	</Target>
	
	<!-- Build Monitoring Microfrontend -->
	<Target Name="BuildMonitoring" AfterTargets="BuildMicrofrontendsOnRebuild" Condition="Exists('$(MonitoringSourcePath)')">
		<Message Text="Building Neo.UI.Monitoring microfrontend..." Importance="high" />
		
		<Exec Command="npm install" WorkingDirectory="$(MonitoringSourcePath)" ContinueOnError="false" />
		
		<Exec Command="npm run build" WorkingDirectory="$(MonitoringSourcePath)" ContinueOnError="false" />
		
		<Message Text="Copying Monitoring build output to wwwroot..." Importance="high" />
		<ItemGroup>
			<_MonitoringFiles Include="$(MonitoringSourcePath)\dist\**\*.*" />
		</ItemGroup>
		<MakeDir Directories="$(MonitoringOutputPath)" Condition="!Exists('$(MonitoringOutputPath)')" />
		<Copy SourceFiles="@(_MonitoringFiles)" DestinationFolder="$(MonitoringOutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
		
		<Message Text="? Monitoring microfrontend built and copied successfully" Importance="high" />
	</Target>
