@using Neo.Bpms.UI.MVC.Helpers
@{
    string currentCulture = CultureHelper.GetCurrentNeutralCulture();
    bool isRtl = CultureHelper.IsRightToLeft();
}

<div class="language-selection">
    <div class="dropdown" style="width: 100%;">
        <a class="text-info language-selector dropdown-toggle" 
           title="انتخاب زبان" 
           href="#" 
           role="button"
           data-toggle="dropdown" 
           aria-haspopup="true" 
           aria-expanded="false" 
           style="
            border-radius: 6px;
            background: #DBEAFE;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-align: center;
            margin-top: 4px;
            padding: 6px 12px;
            width: 100%;
            text-decoration: none;
            color: #1e40af !important;
        ">
            <span class="title-text" style="font-weight:400; flex: 1;" id="current-language-name">@(currentCulture == "fa" ? "فارسی" : "English")</span>
            <svg style="width:20px;height:20px;margin-right: 8px; flex-shrink: 0;" viewBox="0 0 16 16">
                <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#language-blue"/>
            </svg>
        </a>
        <div class="dropdown-menu" style="min-width: 100%;">
            <a class="dropdown-item language-option @(currentCulture == "fa" ? "active" : "")" 
               href="#" 
               data-culture="fa" 
               onclick="changeLanguage('fa'); return false;"
               style="display: flex; align-items: center; gap: 8px;">
                <span>فارسی</span>
            </a>
            <a class="dropdown-item language-option @(currentCulture == "en" ? "active" : "")" 
               href="#" 
               data-culture="en" 
               onclick="changeLanguage('en'); return false;"
               style="display: flex; align-items: center; gap: 8px;">
                <span>English</span>
            </a>
        </div>
    </div>
</div>

<script>
    // Ensure dropdown works properly
    (function() {
        document.addEventListener('DOMContentLoaded', function() {
            var languageSelectors = document.querySelectorAll('.language-selector');
            languageSelectors.forEach(function(selector) {
                selector.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var dropdown = this.closest('.dropdown');
                    if (dropdown) {
                        dropdown.classList.toggle('show');
                    }
                });
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.language-selection')) {
                    document.querySelectorAll('.language-selection .dropdown').forEach(function(dropdown) {
                        dropdown.classList.remove('show');
                    });
                }
            });
        });
    })();

    function changeLanguage(culture) {
        // Close dropdown
        document.querySelectorAll('.language-selection .dropdown').forEach(function(dropdown) {
            dropdown.classList.remove('show');
        });

        // Show loading state
        var languageSelector = document.querySelector('.language-selector');
        if (!languageSelector) return;
        
        var originalText = languageSelector.querySelector('.title-text').textContent;
        languageSelector.querySelector('.title-text').textContent = 'در حال تغییر...';
        languageSelector.style.opacity = '0.6';
        languageSelector.style.pointerEvents = 'none';

        // Update language via API
        fetch('@Url.Action("ChangeCulture", "Account")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'culture=' + encodeURIComponent(culture)
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            if (data && data.success) {
                // Update active state
                document.querySelectorAll('.language-option').forEach(item => {
                    item.classList.remove('active');
                });
                var activeOption = document.querySelector(`.language-option[data-culture="${culture}"]`);
                if (activeOption) {
                    activeOption.classList.add('active');
                }
                
                // Update current language name
                var languageNameElement = document.getElementById('current-language-name');
                if (languageNameElement) {
                    languageNameElement.textContent = culture === 'fa' ? 'فارسی' : 'English';
                }
                
                // Reload page to apply language
                setTimeout(function() {
                    window.location.reload();
                }, 300);
            } else {
                alert('خطا در تغییر زبان: ' + (data.message || 'خطای نامشخص'));
                if (languageSelector && languageSelector.querySelector('.title-text')) {
                    languageSelector.querySelector('.title-text').textContent = originalText;
                }
                languageSelector.style.opacity = '1';
                languageSelector.style.pointerEvents = 'auto';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('خطا در تغییر زبان');
            if (languageSelector && languageSelector.querySelector('.title-text')) {
                languageSelector.querySelector('.title-text').textContent = originalText;
            }
            languageSelector.style.opacity = '1';
            languageSelector.style.pointerEvents = 'auto';
        });
    }
</script>

