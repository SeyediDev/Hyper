@* @using Neo.Bpms.UI.MVC
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Common
@using Neo.Bpms.UI.MVC.ViewModels.Account
@using Neo.Bpms.UI.Resources.Resources
@using Hyper.AdminPanel.Web.ViewModels.Account

@model ChangeUserPasswordViewModel
@{
    ViewBag.Title = ViewTexts.ChangeUsernameAndPassword;
    var pageName = ViewBag.PagePackId as string;
    var pageIcon = PageIconHelper.GetPageMenuIcon(pageName);
}

<partial name="Common/TopBarWithRow" model="new TopBarModel
{
    Title = ViewTexts.ChangeUsersPassword,
    PageIcon = pageIcon
}" />

<div class="row" style="margin-top:-1px;">
    <div class="col-md-12 customDiv">
        <p>
            @ViewTexts.PasswordInstructions
        </p>
        <section id="loginForm">
            @using (Html.BeginForm("ChangeUserPassword", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
            {
	            <span style="color: red; font-weight: bold;">@Html.ValidationSummary(true)</span>
                <div class="form-group">
                    <span class="col-lg-2 col-md-2 col-sm-3 col-form-label rtl" style="margin-bottom: 5px;">@ViewTexts.Username :</span>
                    <div class="col-lg-10 col-md-10 col-sm-9">
                        @Html.TextBoxFor(m => m.UserName, new { @class = "col-lg-8 col-md-8 col-sm-8 form-control" })
                        @Html.ValidationMessageFor(m => m.UserName)
                    </div>
                </div>
                <div class="form-group">
                    <span class="col-lg-2 col-md-2 col-sm-3 col-form-label rtl" style="margin-bottom: 5px;">@ViewTexts.NewUsername :</span>
                    <div class="col-lg-10 col-md-10 col-sm-9">
                        @Html.TextBoxFor(m => m.NewUserName, new { @class = "col-lg-8 col-md-8 col-sm-8 form-control" })
                        @Html.ValidationMessageFor(m => m.NewUserName)
                    </div>
                </div>
                <div class="form-group">
                    <span class="col-lg-2 col-md-2 col-sm-3 col-form-label rtl" style="margin-bottom: 5px;">@ViewTexts.NewPassword :</span>
                    <div class="col-lg-10 col-md-10 col-sm-9">
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "col-lg-8 col-md-8 col-sm-8 form-control" })
                        @Html.ValidationMessageFor(m => m.NewPassword)
                    </div>
                </div>
                <div class="form-group">
                    <span class="col-lg-2 col-md-2 col-sm-3 col-form-label rtl" style="margin-bottom: 5px;">@ViewTexts.ConfirmPassword :</span>
                    <div class="col-lg-10 col-md-10 col-sm-9 ">
                        @Html.PasswordFor(m => m.NewPasswordRepeat, new { @class = "col-lg-8 col-md-8 col-sm-8 form-control" })
                        @Html.ValidationMessageFor(m => m.NewPasswordRepeat)
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="@ViewTexts.ChangeUsernameAndPassword" class="btn btn-primary" />
                    </div>
                </div>
            }
        </section>
    </div>
</div> *@