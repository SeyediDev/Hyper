# ===============================================
# Multi-stage Dockerfile for Hyper.AdminPanel.Web
# Build Context: D:\Projects (parent of all three repos)
# Command: docker build -f Hyper/Backend/src/AdminPanel/Hyper.AdminPanel.Web/Dockerfile.new -t Hyper-admin-web .
# ===============================================

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files for restore
COPY ["Hyper/Backend/Hyper.Backend.sln", "Hyper/Backend/"]
COPY ["Hyper/Backend/Directory.Build.props", "Hyper/Backend/"]
COPY ["Hyper/Backend/Directory.Packages.props", "Hyper/Backend/"]
COPY ["Hyper/Backend/global.json", "Hyper/Backend/"]
COPY ["Hyper/Backend/NuGet.config", "Hyper/Backend/"]

# Copy all csproj files
COPY ["Hyper/Backend/src/AdminPanel/Hyper.AdminPanel.Web/Hyper.AdminPanel.Web.csproj", "Hyper/Backend/src/AdminPanel/Hyper.AdminPanel.Web/"]
COPY ["Hyper/Backend/src/AdminPanel/Hyper.AdminPanel.Domain/Hyper.AdminPanel.Domain.csproj", "Hyper/Backend/src/AdminPanel/Hyper.AdminPanel.Domain/"]
COPY ["Hyper/Backend/src/Core/Hyper.Domain/Hyper.Domain.csproj", "Hyper/Backend/src/Core/Hyper.Domain/"]
COPY ["Hyper/Backend/src/Core/Hyper.Application/Hyper.Application.csproj", "Hyper/Backend/src/Core/Hyper.Application/"]
COPY ["Hyper/Backend/src/Core/Hyper.Infrastructure/Hyper.Infrastructure.csproj", "Hyper/Backend/src/Core/Hyper.Infrastructure/"]

# Copy Neo projects
COPY ["Neo/src/Neo.Common/Neo.Common.csproj", "Neo/src/Neo.Common/"]
COPY ["Neo/src/Neo.Domain/Neo.Domain.csproj", "Neo/src/Neo.Domain/"]
COPY ["Neo/src/Neo.Application/Neo.Application.csproj", "Neo/src/Neo.Application/"]
COPY ["Neo/src/Neo.Infrastructure/Neo.Infrastructure.csproj", "Neo/src/Neo.Infrastructure/"]
COPY ["Neo/src/Neo.Infrastructure.Hangfire/Neo.Infrastructure.Hangfire.csproj", "Neo/src/Neo.Infrastructure.Hangfire/"]
COPY ["Neo/src/Neo.Endpoint/Neo.Endpoint.csproj", "Neo/src/Neo.Endpoint/"]

# Copy Neo.Bpms projects
COPY ["Neo.Bpms/src/Neo.Bpms.Domain/Neo.Bpms.Domain.csproj", "Neo.Bpms/src/Neo.Bpms.Domain/"]
COPY ["Neo.Bpms/src/Neo.Bpms.Domain.Features/Neo.Bpms.Domain.Features.csproj", "Neo.Bpms/src/Neo.Bpms.Domain.Features/"]
COPY ["Neo.Bpms/src/Neo.Bpms.Application/Neo.Bpms.Application.csproj", "Neo.Bpms/src/Neo.Bpms.Application/"]
COPY ["Neo.Bpms/src/Neo.Bpms.Infrastructure/Neo.Bpms.Infrastructure.csproj", "Neo.Bpms/src/Neo.Bpms.Infrastructure/"]
COPY ["Neo.Bpms/src/Neo.Bpms.UI.Resources/Neo.Bpms.UI.Resources.csproj", "Neo.Bpms/src/Neo.Bpms.UI.Resources/"]
COPY ["Neo.Bpms/src/Neo.Bpms.UI.MVC/Neo.Bpms.UI.MVC.csproj", "Neo.Bpms/src/Neo.Bpms.UI.MVC/"]

# Restore dependencies
WORKDIR /src/Hyper/Backend
RUN dotnet restore "src/AdminPanel/Hyper.AdminPanel.Web/Hyper.AdminPanel.Web.csproj"

# Copy all source code
COPY ["Hyper/", "Hyper/"]
COPY ["Neo/", "Neo/"]
COPY ["Neo.Bpms/", "Neo.Bpms/"]

# Build the project
WORKDIR /src/Hyper/Backend/src/AdminPanel/Hyper.AdminPanel.Web
RUN dotnet build "Hyper.AdminPanel.Web.csproj" -c Release -o /app/build --no-restore

# Stage 2: Publish
FROM build AS publish
RUN dotnet publish "Hyper.AdminPanel.Web.csproj" -c Release -o /app/publish --no-restore --no-build /p:UseAppHost=false

# Stage 3: Final Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

# Install necessary dependencies
RUN apt-get update && apt-get install -y \
    libgdiplus \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r Hyperapp && useradd -r -g Hyperapp Hyperapp
RUN chown -R Hyperapp:Hyperapp /app

# Copy published files
COPY --from=publish --chown=Hyperapp:Hyperapp /app/publish .

# Switch to non-root user
USER Hyperapp

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

EXPOSE 80
EXPOSE 443

ENTRYPOINT ["dotnet", "Hyper.AdminPanel.Web.dll"]

