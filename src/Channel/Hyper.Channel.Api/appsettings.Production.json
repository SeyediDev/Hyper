{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  
  "AllowedHosts": "*.your-company.com",

    "ConnectionStrings": {
        "Domain": "Data Source=.;Initial Catalog=Hyperyek;User ID=sa;Password=!QAZ@WSX3edc;MultipleActiveResultSets=True;TrustServerCertificate=True",
        "DomainCommandConnection": "Data Source=.;Initial Catalog=Hyperyek;User ID=sa;Password=!QAZ@WSX3edc;MultipleActiveResultSets=True;TrustServerCertificate=True",
        "DomainQueryConnection": "Data Source=.;Initial Catalog=Hyperyek;User ID=sa;Password=!QAZ@WSX3edc;MultipleActiveResultSets=True;TrustServerCertificate=True"
    },
  
  "Redis": {
    "Configuration": "redis-cluster-prod.internal:6379,redis-cluster-prod.internal:6380,redis-cluster-prod.internal:6381",
    "InstanceName": "Hyper_",
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "AbortOnConnectFail": false,
    "ConnectRetry": 5,
    "KeepAlive": 60,
    "DefaultDatabase": 0,
    "Password": "${REDIS_PASSWORD}",
    "Ssl": true,
    "SslHost": "redis-cluster-prod.internal"
  },
  
  "MongoDB": {
    "ConnectionString": "mongodb://mongo-replica1.internal:27017,mongo-replica2.internal:27017,mongo-replica3.internal:27017/?replicaSet=rs0",
    "DatabaseName": "Hyper",
    "Username": "Hyper_user",
    "Password": "${MONGO_PASSWORD}",
    "Timeout": 30,
    "MaxPoolSize": 100,
    "MinPoolSize": 10
  },
  
  "Caching": {
    "Strategy": "Hybrid",
    "L1_Expiration": 5,
    "L2_Expiration": 30,
    "DefaultExpiration": 60
  },
  
  "DatabaseCache": {
    "Enabled": false,
    "DefaultExpiration": 60,
    "Comment": "Set Enabled to true to enable database query caching"
  },
  
  "Performance": {
    "EnableResponseCompression": true,
    "CompressionLevel": "Optimal",
    "EnableStaticFileCaching": true,
    "StaticFilesCacheMaxAge": 31536000
  },
  
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "Hyper",
    "Audience": "HyperUsers",
    "ExpirationMinutes": 480
  },
  
  "ObjectStorage": {
    "Provider": "S3",
    "BucketName": "Hyper-prod-uploads",
    "Region": "us-east-1",
    "AccessKey": "${S3_ACCESS_KEY}",
    "SecretKey": "${S3_SECRET_KEY}",
    "MaxFileSize": 20971520,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx", ".xls", ".xlsx" ],
    "CdnUrl": "https://cdn.your-company.com"
  },
  
  "CORS": {
    "AllowedOrigins": [
      "https://Hyper-web.your-company.com",
      "https://Hyper-bpms.your-company.com",
      "https://www.your-company.com"
    ]
  },
  
  "Features": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  
  "HealthChecks": {
    "Enabled": true,
    "Path": "/health",
    "DetailedErrors": false
  },
  
  "ApplicationInsights": {
    "InstrumentationKey": "${APPINSIGHTS_KEY}",
    "EnableAdaptiveSampling": true,
    "EnablePerformanceCounterCollectionModule": true
  },
  
  "Security": {
    "EnableHSTS": true,
    "HSTSMaxAge": 31536000,
    "EnableCSP": true,
    "RequireHttps": true
  }
}

