root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

