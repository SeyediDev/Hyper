<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup Condition="'$(UseBuiltPanel)' != 'true'"><ProjectReference Include="../../src/AdminPanel/Hyper.AdminPanel.Web/Hyper.AdminPanel.Web.csproj" /></ItemGroup>
  <!-- Explicit fallback for exercising the last compiled panel when an unrelated
       package restore breaks its project graph. Never presented as a full build. -->
  <ItemGroup Condition="'$(UseBuiltPanel)' == 'true'">
    <Reference Include="../../src/AdminPanel/Hyper.AdminPanel.Web/bin/$(Configuration)/$(TargetFramework)/*.dll" />
  </ItemGroup>
  <Target Name="RequireBuiltPanel" BeforeTargets="ResolveReferences" Condition="'$(UseBuiltPanel)' == 'true'">
    <Error Condition="!Exists('../../src/AdminPanel/Hyper.AdminPanel.Web/bin/$(Configuration)/$(TargetFramework)/Hyper.AdminPanel.Web.dll')" Text="Build the production panel before using UseBuiltPanel." />
  </Target>
</Project>
