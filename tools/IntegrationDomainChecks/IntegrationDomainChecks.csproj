      <HintPath>../../src/Integration/Hyper.Integration.Domain/bin/Debug/net10.0/Hyper.Integration.Domain.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Neo.Domain">
      <HintPath>../../../../Neo/src/Neo.Domain/bin/Debug/net10.0/Neo.Domain.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Neo.Common">
      <HintPath>../../../../Neo/src/Neo.Common/bin/Debug/net10.0/Neo.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
